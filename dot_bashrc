# dont put duplicate lines or lines starting with a space in history
HISTCONTROL=ignoreboth	

man() {
    if [[ -z "$1" ]]; then
        return 1
    fi

    cmd="$1"  # Get the first argument (e.g., 'ls' if you type 'man ls')

    echo -n "Would you like to use tldr instead? y/n: "
    read answer
    if [[ "$answer" =~ ^[Yy][Ee]?[Ss]?$ ]]; then
        command tldr "$cmd"
    else
        command man "$cmd"
    fi
}

